[
  {
    "id": "implement-ticket",
    "version": 1,
    "name": "Implement Ticket",
    "description": "Plan → approve → implement → test → review → draft PR.",
    "category": "feature",
    "workflow": {
      "schemaVersion": 6,
      "id": "tpl-implement-ticket",
      "name": "Implement Ticket",
      "nodes": [
        {
          "id": "start",
          "type": "start",
          "position": {
            "x": 80.0,
            "y": 0.0
          },
          "config": {
            "args": [],
            "extendOnOutput": false
          },
          "label": "Start"
        },
        {
          "id": "plan",
          "type": "agent",
          "position": {
            "x": 80.0,
            "y": 120.0
          },
          "config": {
            "args": [],
            "agentRole": "planning",
            "prompt": "Read the repository instructions first. Plan {{workflow.name}}: {{ticket.key}} {{ticket.title}}. List files and risks.",
            "extendOnOutput": false
          },
          "label": "Plan"
        },
        {
          "id": "gate",
          "type": "approval",
          "position": {
            "x": 80.0,
            "y": 240.0
          },
          "config": {
            "args": [],
            "message": "Review the plan.",
            "extendOnOutput": false
          },
          "label": "Approve plan"
        },
        {
          "id": "impl",
          "type": "agent",
          "position": {
            "x": 80.0,
            "y": 360.0
          },
          "config": {
            "args": [],
            "agentRole": "implementation",
            "prompt": "Read the repository instructions first. Implement the approved plan with tests.",
            "extendOnOutput": false,
            "contextRefs": ["plan"],
            "contextMaxChars": 12000
          },
          "label": "Implement"
        },
        {
          "id": "tests",
          "type": "command",
          "position": {
            "x": 80.0,
            "y": 480.0
          },
          "config": {
            "executable": "sh",
            "args": ["-c", "{{input.testCommand}}"],
            "extendOnOutput": false
          },
          "label": "Project tests"
        },
        {
          "id": "review",
          "type": "agent",
          "position": {
            "x": 80.0,
            "y": 600.0
          },
          "config": {
            "args": [],
            "agentRole": "deepReview",
            "prompt": "Read the repository instructions first. Review for P0/P1; tag severities.",
            "extendOnOutput": false,
            "contextRefs": ["impl", "tests"],
            "contextMaxChars": 12000
          },
          "label": "Review"
        },
        {
          "id": "end",
          "type": "end",
          "position": {
            "x": 80.0,
            "y": 720.0
          },
          "config": {
            "args": [],
            "extendOnOutput": false
          },
          "label": "End"
        }
      ],
      "edges": [
        {
          "id": "e0",
          "source": "start",
          "target": "plan"
        },
        {
          "id": "e1",
          "source": "plan",
          "target": "gate"
        },
        {
          "id": "e2",
          "source": "gate",
          "target": "impl"
        },
        {
          "id": "e3",
          "source": "impl",
          "target": "tests"
        },
        {
          "id": "e4",
          "source": "tests",
          "target": "review"
        },
        {
          "id": "e5",
          "source": "review",
          "target": "end"
        }
      ],
      "inputs": [
        {
          "name": "testCommand",
          "label": "Project test command (required)",
          "required": true
        }
      ]
    }
  },
  {
    "id": "review-pr",
    "version": 1,
    "name": "Review Pull Request",
    "description": "Load PR → parallel Claude/Codex reviews → actionable? → note or checked.",
    "category": "review",
    "workflow": {
      "schemaVersion": 6,
      "id": "tpl-review-pr",
      "name": "Review Pull Request",
      "nodes": [
        {
          "id": "start",
          "type": "start",
          "position": {
            "x": 80.0,
            "y": 0.0
          },
          "config": {
            "args": [],
            "extendOnOutput": false
          },
          "label": "Start"
        },
        {
          "id": "files",
          "type": "github",
          "position": {
            "x": 80.0,
            "y": 120.0
          },
          "config": {
            "args": [],
            "extendOnOutput": false,
            "githubOp": {
              "op": "prFiles",
              "number": 0
            }
          },
          "label": "Changed files"
        },
        {
          "id": "revA",
          "type": "agent",
          "position": {
            "x": 80.0,
            "y": 240.0
          },
          "config": {
            "args": [],
            "agentRole": "fastReview",
            "prompt": "Read the repository instructions first. Fast review with ```finding blocks.",
            "extendOnOutput": false,
            "contextRefs": ["files"],
            "contextMaxChars": 12000
          },
          "label": "Claude Review"
        },
        {
          "id": "revB",
          "type": "agent",
          "position": {
            "x": 80.0,
            "y": 240.0
          },
          "config": {
            "args": [],
            "agentRole": "deepReview",
            "prompt": "Read the repository instructions first. Deep review with ```finding blocks.",
            "extendOnOutput": false,
            "contextRefs": ["files"],
            "contextMaxChars": 12000
          },
          "label": "Codex Review"
        },
        {
          "id": "cond",
          "type": "condition",
          "position": {
            "x": 80.0,
            "y": 360.0
          },
          "config": {
            "args": [],
            "extendOnOutput": false,
            "condition": {
              "logic": "or",
              "clauses": [
                {
                  "left": "node.revA.severity",
                  "op": "contains",
                  "right": "P0"
                },
                {
                  "left": "node.revB.severity",
                  "op": "contains",
                  "right": "P1"
                }
              ]
            }
          },
          "label": "Actionable?"
        },
        {
          "id": "note",
          "type": "github",
          "position": {
            "x": 80.0,
            "y": 480.0
          },
          "config": {
            "args": [],
            "extendOnOutput": false,
            "githubOp": {
              "op": "postComment",
              "number": 0,
              "body": "Automated review found P0/P1 items.\n\n<sub>posted by Orchevia</sub>"
            }
          },
          "label": "Post note"
        },
        {
          "id": "checked",
          "type": "command",
          "position": {
            "x": 80.0,
            "y": 480.0
          },
          "config": {
            "executable": "echo",
            "args": ["no actionable findings"],
            "extendOnOutput": false
          },
          "label": "Mark checked"
        },
        {
          "id": "end",
          "type": "end",
          "position": {
            "x": 80.0,
            "y": 600.0
          },
          "config": {
            "args": [],
            "extendOnOutput": false
          },
          "label": "End"
        }
      ],
      "edges": [
        {
          "id": "e0",
          "source": "start",
          "target": "files"
        },
        {
          "id": "e1",
          "source": "files",
          "target": "revA"
        },
        {
          "id": "e2",
          "source": "files",
          "target": "revB"
        },
        {
          "id": "e3",
          "source": "revA",
          "target": "cond"
        },
        {
          "id": "e4",
          "source": "revB",
          "target": "cond"
        },
        {
          "id": "e5",
          "source": "cond",
          "target": "note",
          "label": "true"
        },
        {
          "id": "e6",
          "source": "cond",
          "target": "checked",
          "label": "false"
        },
        {
          "id": "e7",
          "source": "note",
          "target": "end"
        },
        {
          "id": "e8",
          "source": "checked",
          "target": "end"
        }
      ]
    }
  },
