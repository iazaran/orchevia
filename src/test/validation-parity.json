          },
          {
            "id": "add",
            "type": "git",
            "config": {
              "gitOp": { "op": "worktreeAdd", "path": "", "branch": "has space" }
            }
          },
          {
            "id": "remove",
            "type": "git",
            "config": { "gitOp": { "op": "worktreeRemove", "path": " " } }
          },
          {
            "id": "fine",
            "type": "git",
            "config": {
              "workingDir": "/elsewhere",
              "gitOp": { "op": "worktreeAdd", "path": "../wt", "branch": " " }
            }
          },
          { "id": "end", "type": "end" }
        ],
        "edges": [
          { "id": "e1", "source": "start", "target": "noop" },
          { "id": "e2", "source": "noop", "target": "create" },
          { "id": "e3", "source": "create", "target": "checkout" },
          { "id": "e4", "source": "checkout", "target": "stage" },
          { "id": "e5", "source": "stage", "target": "stage-none" },
          { "id": "e6", "source": "stage-none", "target": "commit" },
          { "id": "e7", "source": "commit", "target": "add" },
          { "id": "e8", "source": "add", "target": "remove" },
          { "id": "e9", "source": "remove", "target": "fine" },
          { "id": "e10", "source": "fine", "target": "end" }
        ]
      },
