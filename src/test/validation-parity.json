            "id": "after",
            "type": "command",
            "config": { "executable": "echo", "maxVisits": 2 }
          }
        ],
        "edges": [
          { "id": "e1", "source": "start", "target": "end" },
          { "id": "e2", "source": "end", "target": "after" },
          { "id": "back", "source": "after", "target": "end" }
        ]
      },
      "issues": [
        {
          "code": "cycle-needs-condition",
          "severity": "error",
          "nodeId": "after",
          "edgeId": "back"
        },
        {
          "code": "cycle-into-end",
          "severity": "error",
          "nodeId": "end",
          "edgeId": "back"
        }
      ]
    },
