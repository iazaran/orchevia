    {
      "name": "loops need a Condition and bounds, reported once per step",
      "workflow": {
        "nodes": [
          { "id": "start", "type": "start" },
          { "id": "a", "type": "command", "config": { "executable": "make" } },
          { "id": "b", "type": "command", "config": { "executable": "make" } },
          {
            "id": "cond",
            "type": "condition",
            "config": {
              "maxVisits": 3,
              "condition": {
                "logic": "and",
                "clauses": [
                  { "left": "node.b.exitCode", "op": "notEquals", "right": "0" }
                ]
              }
            }
          },
          { "id": "end", "type": "end" }
        ],
        "edges": [
          { "id": "e1", "source": "start", "target": "a" },
          { "id": "e2", "source": "a", "target": "b" },
          { "id": "e3", "source": "b", "target": "cond" },
          { "id": "again", "source": "cond", "target": "a", "label": "true" },
          { "id": "done", "source": "cond", "target": "end", "label": "false" },
          { "id": "back", "source": "b", "target": "a", "label": "failure" }
        ]
      },
      "issues": [
        { "code": "cycle-unbounded", "severity": "error", "nodeId": "a" },
        { "code": "cycle-unbounded", "severity": "error", "nodeId": "b" }
      ]
    },
    {
      "name": "a guarded, bounded review loop is fine",
      "workflow": {
        "nodes": [
          { "id": "start", "type": "start" },
          {
            "id": "review",
            "type": "agent",
            "config": { "agentRole": "fastReview", "prompt": "Review", "maxVisits": 3 }
          },
          {
            "id": "cond",
            "type": "condition",
            "config": {
              "maxVisits": 3,
              "condition": {
                "logic": "or",
                "clauses": [
                  { "left": "node.review.severity", "op": "contains", "right": "P1" }
                ]
              }
            }
          },
          {
            "id": "fix",
            "type": "agent",
            "config": {
              "agentRole": "implementation",
              "prompt": "Fix {{node.review.output}} (visit {{node.fix.visits}})",
              "maxVisits": 3
            }
          },
          { "id": "end", "type": "end" }
        ],
        "edges": [
          { "id": "e1", "source": "start", "target": "review" },
          { "id": "e2", "source": "review", "target": "cond" },
          { "id": "e3", "source": "cond", "target": "fix", "label": "true" },
          { "id": "e4", "source": "cond", "target": "end", "label": "false" },
          { "id": "e5", "source": "fix", "target": "review" }
        ]
      },
      "issues": []
    },
    {
      "name": "a loop back into an End step",
      "workflow": {
        "nodes": [
          { "id": "start", "type": "start" },
          { "id": "end", "type": "end", "config": { "maxVisits": 2 } },
