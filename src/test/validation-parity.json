{
  "about": "Shared by validate_workflow (crates/core/src/workflow.rs) and validateWorkflowLocal (src/lib/workflow.ts). Both must report exactly the issues listed for every case (code, severity, nodeId, edgeId; order and messages are not compared). Missing workflow fields default to schemaVersion = current, id 'wf-parity', name 'Parity'; nodes default to position {0,0} and config {}.",
  "codes": [
    "schema-too-new",
    "name-required",
    "single-start",
    "end-required",
    "edge-unknown-source",
    "edge-unknown-target",
    "edge-self-loop",
    "command-executable-required",
    "command-executable-suspicious",
    "command-timeout-invalid",
    "command-script-required",
    "command-script-templated",
    "command-script-dir-required",
    "command-script-misplaced",
    "agent-session-group-invalid",
    "agent-session-variable-invalid",
    "agent-session-turns-invalid",
    "agent-context-limit-invalid",
    "agent-context-ref-invalid",
    "agent-profile-required",
    "agent-role-unknown",
    "agent-prompt-required",
    "agent-timeout-invalid",
    "agent-input-unknown",
    "agent-tool-allowance-invalid",
    "agent-subagent-allowance-invalid",
    "agent-required-tools-invalid",
    "agent-allowance-misplaced",
    "agent-required-tools-misplaced",
    "prompt-unknown-variable",
    "condition-required",
    "condition-unknown-ref",
    "condition-branches-required",
    "git-op-required",
    "git-dir-required",
    "git-branch-required",
    "git-branch-invalid",
    "git-paths-required",
    "git-message-required",
    "git-path-required",
    "github-op-required",
    "github-title-required",
    "github-branches-required",
    "github-body-required",
    "ticket-key-required",
    "ticket-server-required",
    "mcp-server-required",
    "mcp-tool-required",
    "retry-unbounded",
    "retry-delay-invalid",
    "loop-limit-invalid",
    "input-name-invalid",
    "input-duplicate",
    "workflow-limits-invalid",
    "edge-label-unknown",
    "edge-label-misplaced",
    "cycle-needs-condition",
    "cycle-unbounded",
    "cycle-into-end",
    "unreachable-node",
    "dead-end-node"
  ],
  "setupCodes": [
    "git-dir-required",
    "command-script-dir-required",
    "ticket-server-required",
    "mcp-server-required"
  ],
  "exemptions": [
    {
      "code": "input-required",
      "reason": "Checked when a run starts, against the values the run was given; a saved workflow has no run inputs yet."
    },
    {
      "code": "agent-role-unresolved",
      "reason": "Checked when a run starts: roles are fine in templates and drafts and only block a real run."
    },
    {
      "code": "agent-profile-missing",
      "reason": "Needs the saved Agent Profiles (database); the browser validator cannot see which profiles exist."
    },
    {
      "code": "agent-session-profile-invalid",
      "reason": "Needs the referenced Agent Profile's adapter and arguments (database)."
    },
    {
      "code": "agent-cli-unavailable",
      "reason": "Needs the machine's PATH to find the profile's CLI."
    },
    {
      "code": "git-cli-unavailable",
      "reason": "Needs the machine's PATH to find git."
    },
    {
      "code": "gh-cli-unavailable",
      "reason": "Needs the machine's PATH to find gh."
    },
    {
      "code": "mcp-server-missing",
      "reason": "Needs the configured MCP servers (database)."
    },
    {
      "code": "mcp-server-disabled",
      "reason": "Needs the configured MCP servers (database)."
    },
    {
      "code": "mcp-server-unavailable",
      "reason": "Needs the machine's PATH to find the MCP server command."
    }
  ],
  "cases": [
    {
      "name": "a valid linear workflow reports nothing",
      "workflow": {
        "nodes": [
          { "id": "start", "type": "start" },
          {
            "id": "cmd",
            "type": "command",
            "config": { "executable": "echo", "args": ["hi"] }
          },
          { "id": "end", "type": "end" }
        ],
        "edges": [
          { "id": "e1", "source": "start", "target": "cmd" },
          { "id": "e2", "source": "cmd", "target": "end" }
        ]
      },
      "issues": []
    },
    {
      "name": "a newer schema stops validation",
      "workflow": { "schemaVersion": 99, "name": "", "nodes": [], "edges": [] },
      "issues": [{ "code": "schema-too-new", "severity": "error" }]
    },
    {
      "name": "name, start and end are required",
      "workflow": {
