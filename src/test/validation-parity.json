          },
          {
            "id": "templated",
            "type": "git",
            "config": { "gitOp": { "op": "checkout", "name": "{{input.branch}}" } }
          },
          {
            "id": "long",
            "type": "git",
            "config": {
              "gitOp": {
                "op": "checkout",
                "name": "ééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééé"
              }
            }
          },
          { "id": "end", "type": "end" }
        ],
        "edges": [
          { "id": "e1", "source": "start", "target": "tilde" },
          { "id": "e2", "source": "tilde", "target": "dash" },
          { "id": "e3", "source": "dash", "target": "slash" },
          { "id": "e4", "source": "slash", "target": "quote" },
          { "id": "e5", "source": "quote", "target": "templated" },
          { "id": "e6", "source": "templated", "target": "long" },
          { "id": "e7", "source": "long", "target": "end" }
        ]
      },
      "issues": [
