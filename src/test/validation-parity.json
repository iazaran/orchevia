    {
      "name": "conditions need clauses, known variables and both branches",
      "workflow": {
        "inputs": [{ "name": "mode" }],
        "nodes": [
          { "id": "start", "type": "start" },
          { "id": "none", "type": "condition" },
          {
            "id": "empty",
            "type": "condition",
            "config": { "condition": { "logic": "and", "clauses": [] } }
          },
          {
            "id": "refs",
            "type": "condition",
            "config": {
              "condition": {
                "logic": "or",
                "clauses": [
                  { "left": "input.mode", "op": "equals", "right": "fast" },
                  { "left": "node.ghost.output", "op": "contains", "right": "x" },
                  { "left": "input.speed", "op": "notEquals", "right": "x" },
                  { "left": "start", "op": "equals", "right": "x" }
                ]
              }
            }
          },
          {
            "id": "half",
            "type": "condition",
            "config": {
              "condition": {
                "logic": "and",
                "clauses": [{ "left": "workflow.name", "op": "equals", "right": "x" }]
              }
            }
          },
          { "id": "end", "type": "end" }
        ],
        "edges": [
          { "id": "e1", "source": "start", "target": "none" },
          { "id": "e2", "source": "none", "target": "empty" },
          { "id": "e3", "source": "empty", "target": "refs" },
          { "id": "e4", "source": "refs", "target": "half", "label": " YES " },
          { "id": "e5", "source": "refs", "target": "end", "label": "On False" },
          { "id": "e6", "source": "half", "target": "end", "label": "true" }
